# Copie este arquivo para .env (na mesma pasta) e preencha. O .env nunca vai para o Git.

# Token do GitHub (fine-grained, só no repositório da issue, permissão "Issues: read and write").
GITHUB_TOKEN=

# Issue que serve de chat: dono/repositorio#numero
ISSUE=nord-center-org/nord-center-infra-agent#1

# Quem pode mandar pedidos (logins do GitHub, separados por vírgula). Comentário de mais ninguém é executado.
AUTORIZADOS=NgmaL0re

# Qual IA trabalha: gemini (Gemini CLI logado com a conta Google) ou claude (Claude Code logado com a assinatura).
AGENTE=gemini

# Pasta com os clones dos repositórios (nord-tool-frontend, nord-tool-backend, nord-tool-scripts-sql, nord-center-infra-agent).
PASTA_TRABALHO=C:\Users\voce\nord

# Opcionais
INTERVALO_S=30
TEMPO_MAX_MIN=60
# AGENTE_ARGS=   (troca os argumentos padrão do agente; o pedido sempre vai pela entrada padrão)
